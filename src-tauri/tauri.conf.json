{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipboard History",
  "version": "0.1.1",
  "identifier": "com.clipboardhistory.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "Clipboard History",
        "width": 360,
        "height": 480,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Clipboard History Settings",
        "width": 720,
        "height": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2OTgyRjQwNjE2RkQzMTUKUldRVjAyOWhRQytZQm1xanVKdk9kN3QzRlEyZWpmeXU4aHhBeTV1QmxCMDI3NkZQK1NTdXpnR2MK",
      "endpoints": [
        "https://github.com/iamraihan/clipboard-history/releases/latest/download/latest.json"
      ]
    }
  }
}
